#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPOSITORY_ROOT / "src"))

from agent_creation.architecture_planner import (
    ArchitecturePlanningError,
    create_architecture_artifacts,
    validate_architecture_artifacts,
)
from agent_creation.resume_reconcile import ReconciliationError, reconcile_architecture


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", default=str(REPOSITORY_ROOT))
    commands = parser.add_subparsers(dest="command", required=True)
    plan = commands.add_parser("plan")
    plan.add_argument("--input", required=True)
    reconcile = commands.add_parser("reconcile")
    reconcile.add_argument("--receipt", required=True)
    reconcile.add_argument("--input", required=True)
    commands.add_parser("validate")
    arguments = parser.parse_args()
    root = Path(arguments.root).resolve()
    try:
        if arguments.command in {"plan", "reconcile"}:
            request = json.loads(Path(arguments.input).read_text(encoding="utf-8"))
            if arguments.command == "plan":
                paths = create_architecture_artifacts(root, request)
                result = {
                    "status": "complete",
                    "architecture": paths["shape"],
                    "artifacts": {key: str(value) for key, value in paths.items() if key != "shape"},
                }
            else:
                result = reconcile_architecture(root, Path(arguments.receipt), request)
        else:
            errors = validate_architecture_artifacts(root)
            result = {"status": "valid" if not errors else "invalid", "errors": errors}
            print(json.dumps(result, sort_keys=True))
            return 0 if not errors else 1
    except (OSError, UnicodeError, json.JSONDecodeError, ArchitecturePlanningError, ReconciliationError) as error:
        result = {
            "status": "invalid",
            "errors": error.issues
            if isinstance(error, (ArchitecturePlanningError, ReconciliationError))
            else [str(error)],
        }
        print(json.dumps(result, sort_keys=True))
        return 1
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
