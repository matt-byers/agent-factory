#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPOSITORY_ROOT / "src"))

from agent_creation.lifecycle import LifecycleError, advance, resume, setup, start, status


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser()
    command.add_argument("--root", default=str(REPOSITORY_ROOT))
    subcommands = command.add_subparsers(dest="command", required=True)

    setup_command = subcommands.add_parser("setup")
    setup_command.add_argument("--simulator-model", required=True)
    setup_command.add_argument("--judge-model", required=True)
    setup_command.add_argument("--evidence-mode", choices=("local", "langsmith", "langfuse"), required=True)
    setup_command.add_argument("--engineering-loop", choices=("included", "external"), required=True)

    start_command = subcommands.add_parser("start")
    start_command.add_argument("lifecycle", choices=("first-build", "improvement"))
    start_command.add_argument("--engineering-loop", choices=("included", "external"))

    subcommands.add_parser("status")
    subcommands.add_parser("next")
    resume_command = subcommands.add_parser("resume")
    resume_command.add_argument("--receipt", required=True)
    return command


def main() -> int:
    arguments = parser().parse_args()
    root = Path(arguments.root).resolve()
    try:
        if arguments.command == "setup":
            result = setup(
                root,
                arguments.simulator_model,
                arguments.judge_model,
                arguments.evidence_mode,
                arguments.engineering_loop,
            )
        elif arguments.command == "start":
            result = start(root, arguments.lifecycle, arguments.engineering_loop)
        elif arguments.command == "status":
            result = status(root)
        elif arguments.command == "next":
            result = advance(root)
        else:
            result = resume(root, Path(arguments.receipt))
    except LifecycleError as error:
        result = {"error": str(error), **error.details}
        print(json.dumps(result, sort_keys=True))
        return 1
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
