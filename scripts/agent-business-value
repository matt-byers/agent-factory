#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPOSITORY_ROOT / "src"))

from agent_creation.business_value import MARKDOWN_PATH, YAML_PATH, BusinessModelError, create_projections, validate_projection


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", default=str(REPOSITORY_ROOT))
    commands = parser.add_subparsers(dest="command", required=True)
    calculate = commands.add_parser("calculate")
    calculate.add_argument("--input", required=True)
    commands.add_parser("validate")
    arguments = parser.parse_args()
    root = Path(arguments.root).resolve()
    try:
        if arguments.command == "calculate":
            model = json.loads(Path(arguments.input).read_text(encoding="utf-8"))
            paths = create_projections(model, root)
            result = {"status": "complete", "artifacts": {key: str(path) for key, path in paths.items()}}
        else:
            errors = validate_projection(root / YAML_PATH, root / MARKDOWN_PATH)
            result = {"status": "valid" if not errors else "invalid", "errors": errors}
            print(json.dumps(result, sort_keys=True))
            return 0 if not errors else 1
    except (OSError, UnicodeError, json.JSONDecodeError, BusinessModelError) as error:
        result = {"status": "invalid", "errors": error.issues if isinstance(error, BusinessModelError) else [str(error)]}
        print(json.dumps(result, sort_keys=True))
        return 1
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
